---
import Layout from "../layouts/Layout.astro";
import ProductDemo from "../components/ProductDemo.tsx";
import AgentTile from "../components/AgentTile.astro";
import { CONNECTOR_CATALOG } from "../../../contracts/connector-catalog.ts";

// Every catalog connector that has a mark in the app (svgl.app), in catalog
// order. Files are `<id>.svg`, or `<id>-light.svg` when the app also ships a
// dark version; the page is light, so it takes the light one.
const logoFiles = import.meta.glob<{ default: { src: string } }>(
    "../../../src/assets/connector-logos/*.svg",
    { eager: true },
);
const logoFor = (id: string) =>
    logoFiles[`../../../src/assets/connector-logos/${id}-light.svg`] ??
    logoFiles[`../../../src/assets/connector-logos/${id}.svg`];
const STALE_LOGOS = new Set(["canva", "huggingface"]);
const connectorLogos = CONNECTOR_CATALOG.flatMap((entry) => {
    if (STALE_LOGOS.has(entry.id)) return [];
    const file = logoFor(entry.id);
    return file ? [{ name: entry.name, src: file.default.src }] : [];
});
