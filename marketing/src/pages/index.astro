<script>
    // Start the platform download immediately, then land on /download?started=1
    // so the page can confirm it and offer a fallback link + setup steps.
    // Triggered by the hero button click or by pressing "D" (the button's
    // keycap hint).
    const heroDownload = document.querySelector("#hero-download");
    let downloadInFlight = false;

    function startDownload() {
        if (downloadInFlight) return;
        downloadInFlight = true;
        const isWindows = /win/i.test(navigator.userAgent);
        const manifestUrl = isWindows
            ? "/api/launcher/latest-windows.json"
            : "/api/launcher/latest.json";
        fetch(manifestUrl, { cache: "no-store" })
            .then((response) => {
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                return response.json();
            })
            .then((manifest) => {
                const url = new URL(manifest.url, window.location.origin);
                if (url.protocol !== "https:") throw new Error("bad url");
                // Assigning location to an attachment response (.dmg/.exe)
                // downloads without unloading the page — most reliable
                // cross-browser trigger (anchor+download is ignored
                // cross-origin and can be swallowed).
                window.location.href = url.toString();
                window.setTimeout(() => {
                    window.location.href = "/download?started=1";
                }, 1200);
            })
            .catch(() => {
                // No file to start — land without the started flag so the
                // page doesn't claim a download began.
                window.location.href = "/download";
            });
    }

    heroDownload?.addEventListener("click", (event) => {
        event.preventDefault();
        startDownload();
    });

    window.addEventListener("keydown", (event) => {
        if (event.key !== "d" && event.key !== "D") return;
        if (event.metaKey || event.ctrlKey || event.altKey || event.repeat)
            return;
        const target = event.target;
        if (
            target instanceof HTMLElement &&
            (target.isContentEditable ||
                /^(input|textarea|select)$/i.test(target.tagName))
        )
            return;
        event.preventDefault();
        startDownload();
    });
</script>

