        --canvas-purple: #a54cf1;
        --canvas-purple-soft: #e8d9fa;
        --canvas-muted: #6e6e6e;
        background: var(--canvas-bg) !important;
        color: var(--canvas-ink) !important;
    }

    .home-shell {
        position: relative;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        width: 100%;
        min-height: 100svh;
        margin: 0;
        border: none;
        overflow: hidden;
        isolation: isolate;
    }

    .hero-demo {
        width: 100%;
        max-width: 112rem;
        margin: 0.5rem auto 0;
    }
    .hero-demo > section {
        box-sizing: border-box;
        height: auto !important;
        min-height: 0;
        width: 100% !important;
        padding: 0 !important;
        background: transparent !important;
    }

    .agents-section {
        box-sizing: border-box;
        width: 100vw;
        min-height: 100svh;
        padding: clamp(1.15rem, 3vw, 3.75rem);
        background: var(--canvas-bg);
    }

    .agents-board {
        box-sizing: border-box;
        min-height: calc(100svh - clamp(2.3rem, 6vw, 7.5rem));
        padding: clamp(4rem, 10.5vh, 8rem) clamp(2rem, 6.5vw, 8rem)
            clamp(2.5rem, 5vw, 5rem);
        border: none;
        overflow: hidden;
    }

    .agents-layout {
        display: grid;
        grid-template-columns: minmax(20rem, 0.88fr) minmax(38rem, 1.28fr);
        align-items: center;
        gap: clamp(2rem, 5.2vw, 7rem);
        min-height: calc(100svh - clamp(11rem, 21vw, 19rem));
    }

    .agents-copy {
        align-self: start;
    }

    .agents-title {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.2em;
        margin: 0;
        color: #565656;
        font-family: "Figtree Variable", sans-serif;
        font-size: clamp(3rem, 4.2vw, 5rem);
        font-weight: 420;
        line-height: 0.94;
        letter-spacing: -0.09em;
    }

    .agents-title__accent {
        color: #b66509;
        font-weight: 520;
    }

    .agent-list {
